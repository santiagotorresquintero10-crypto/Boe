rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }

    match /doctors/{id}   { allow read, write: if isAuth(); }
    match /formatos/{id}  { allow read, write: if isAuth(); }
    match /groups/{id}    { allow read, write: if isAuth(); }
    match /facturas/{id}  { allow read, write: if isAuth(); }
    match /doctorStyles/{id} { allow read, write: if isAuth(); }
    match /egresos/{id}       { allow read, write: if isAuth(); }
    match /tablasEgreso/{id}  { allow read, write: if isAuth(); }
    match /turnos/{id}        { allow read, write: if isAuth(); }

    match /users/{id} {
      allow read: if isAuth();
      allow create, update: if isAuth() && request.auth.uid == id;
      allow delete: if false;
    }

    match /tareas/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isAuth() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.asignadoId == request.auth.uid
      );
    }

    // Notificaciones: cualquier usuario autenticado puede crear
    // Solo el destinatario puede leer y actualizar las suyas
    match /notificaciones/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isAuth() &&
        resource.data.toUid == request.auth.uid;
    }

    // Canales fijos de chat
    match /chat_general/{m}     { allow read, write: if isAuth(); }
    match /chat_facturacion/{m} { allow read, write: if isAuth(); }
    match /chat_radicacion/{m}  { allow read, write: if isAuth(); }
    match /chat_glosas/{m}      { allow read, write: if isAuth(); }
    match /chat_avisos/{m}      { allow read, write: if isAuth(); }

    // ══ PERMISOS POR USUARIO ══
    // Solo los administradores pueden escribir permisos.
    // Cada usuario puede leer su propio documento; los admins pueden leer todos.
    function esAdminEmail() {
      return isAuth() && request.auth.token.email in [
        'santiagotorresquintero10@gmail.com',
        'yajaira.quinteroj@gmail.com'
      ];
    }
    match /permisos/{uid} {
      allow read:  if isAuth() && (request.auth.uid == uid || esAdminEmail());
      allow write: if esAdminEmail();
    }

    // ══ COMPROBANTES DE PAGO (UROEXPERTOS) ══
    // Acceso para quien tiene la vista UROEXPERTOS (o no tiene permisos restringidos) y para admins.
    function puedeEgresos() {
      return isAuth() && (
        esAdminEmail() ||
        !exists(/databases/$(database)/documents/permisos/$(request.auth.uid)) ||
        'egresos' in get(/databases/$(database)/documents/permisos/$(request.auth.uid)).data.vistas
      );
    }
    function metaComp(id) { return /databases/$(database)/documents/comprobantes/$(id); }
    match /comprobantes/{id} {
      allow read:   if puedeEgresos();
      allow create: if puedeEgresos() && request.resource.data.subidoPorUid == request.auth.uid
                    && request.resource.data.estado == 'subiendo';
      // Solo quien lo subió marca la carga como completa
      allow update: if puedeEgresos() && resource.data.subidoPorUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','verificadoISO']);
      // Eliminar: administradores o quien lo subió
      allow delete: if puedeEgresos() && (esAdminEmail() || resource.data.subidoPorUid == request.auth.uid);
    }
    match /comprobantesChunks/{id} {
      allow read:   if puedeEgresos();
      allow create: if puedeEgresos()
                    && request.resource.data.data is string
                    && request.resource.data.data.size() <= 750000
                    && exists(metaComp(request.resource.data.compId))
                    && get(metaComp(request.resource.data.compId)).data.subidoPorUid == request.auth.uid;
      allow update: if false;
      allow delete: if puedeEgresos() && (
                      esAdminEmail() ||
                      !exists(metaComp(resource.data.compId)) ||
                      get(metaComp(resource.data.compId)).data.subidoPorUid == request.auth.uid);
    }

    // Todo lo demás (grupos chat, groupMessages_, etc).
    // IMPORTANTE: en Firestore basta con que UNA regla permita; por eso esta regla general
    // excluye las colecciones protegidas (antes dejaba escribir 'permisos' a cualquier usuario).
    match /{col}/{id} {
      allow read, write: if isAuth() && !(col in ['permisos','comprobantes','comprobantesChunks']);
    }
  }
}
